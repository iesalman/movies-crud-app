<%- include('../../partials/siteHeader', {pageTitle: "Add New Movie"}) %>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-white mb-1">Add New Movie</h2>
                    <p class="text-secondary mb-0">Fill in the details to add a new movie to the collection</p>
                </div>
                <a href="/movies" class="btn-cinema-outline">
                    <i class="bi bi-arrow-left"></i> Back to Movies
                </a>
            </div>

            <div class="content-box">
                <form action="/movies/store" method="POST" enctype="multipart/form-data">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label for="title" class="form-label form-label-custom">
                                    <i class="bi bi-film me-1 text-danger"></i> Movie Title <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control form-control-cinema" id="title" name="title" 
                                       placeholder="e.g. Inception, The Dark Knight" required>
                            </div>

                            <div class="mb-3">
                                <label for="year" class="form-label form-label-custom">
                                    <i class="bi bi-calendar-event me-1 text-danger"></i> Release Year <span class="text-danger">*</span>
                                </label>
                                <input type="number" class="form-control form-control-cinema" id="year" name="year" 
                                       placeholder="2024" min="1880" max="2100" value="2024" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label form-label-custom">
                                    <i class="bi bi-tags me-1 text-danger"></i> Select Genres
                                </label>
                                <div class="genre-selector-container">
                                    <% if (typeof allGenres !== 'undefined' && allGenres.length > 0) { %>
                                        <% allGenres.forEach(function(g) { %>
                                            <label class="genre-checkbox-label">
                                                <input type="checkbox" name="genres" value="<%= g %>" class="genre-checkbox-input">
                                                <span class="genre-chip">
                                                    <i class="bi bi-tag-fill small"></i>
                                                    <%= g %>
                                                </span>
                                            </label>
                                        <% }); %>
                                    <% } else { %>
                                        <input type="text" class="form-control form-control-cinema" name="genres" placeholder="Action, Drama, Comedy">
                                    <% } %>
                                </div>
                                <small class="text-muted">Click on genres to select/unselect</small>
                            </div>

                            <div class="mb-3">
                                <label for="cast" class="form-label form-label-custom">
                                    <i class="bi bi-people me-1 text-danger"></i> Cast
                                </label>
                                <input type="text" class="form-control form-control-cinema" id="cast" name="cast" 
                                       placeholder="e.g. Leonardo DiCaprio, Joseph Gordon-Levitt">
                                <small class="text-muted">Comma-separated actor names</small>
                            </div>

                            <div class="mb-3">
                                <label for="thumbnail" class="form-label form-label-custom">
                                    <i class="bi bi-link-45deg me-1 text-danger"></i> Poster Image URL (Optional)
                                </label>
                                <input type="url" class="form-control form-control-cinema" id="thumbnail" name="thumbnail" 
                                       placeholder="https://example.com/poster.jpg" oninput="previewUrl(this.value)">
                            </div>

                            <div class="mb-3">
                                <label for="photo" class="form-label form-label-custom">
                                    <i class="bi bi-upload me-1 text-danger"></i> Or Upload Poster File
                                </label>
                                <input type="file" class="form-control form-control-cinema" id="photo" name="photo" 
                                       accept="image/*" onchange="previewFile(this)">
                            </div>

                            <div class="mb-4">
                                <label for="extract" class="form-label form-label-custom">
                                    <i class="bi bi-text-paragraph me-1 text-danger"></i> Synopsis / Extract
                                </label>
                                <textarea class="form-control form-control-cinema" id="extract" name="extract" 
                                          rows="4" placeholder="Brief story overview..."></textarea>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-cinema">
                                    <i class="bi bi-check-lg"></i> Save Movie
                                </button>
                                <a href="/movies" class="btn-cinema-outline">Cancel</a>
                            </div>
                        </div>

                        <!-- Poster Preview Column -->
                        <div class="col-md-5">
                            <label class="form-label form-label-custom d-block">Poster Preview</label>
                            <div class="preview-box" id="previewContainer">
                                <div class="text-center text-muted" id="previewPlaceholder">
                                    <i class="bi bi-image fs-1 d-block mb-2"></i>
                                    <small>Image preview will appear here</small>
                                </div>
                                <img src="" id="photoPreview" alt="Poster preview" style="display: none;">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewFile(inputFile) {
        const file = inputFile.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById("photoPreview");
                img.src = e.target.result;
                img.style.display = "block";
                document.getElementById("previewPlaceholder").style.display = "none";
            };
            reader.readAsDataURL(file);
        }
    }

    function previewUrl(url) {
        if (url && url.trim().length > 10) {
            const img = document.getElementById("photoPreview");
            img.src = url.trim();
            img.style.display = "block";
            document.getElementById("previewPlaceholder").style.display = "none";
            img.onerror = function() {
                img.style.display = "none";
                document.getElementById("previewPlaceholder").style.display = "block";
            };
        }
    }
</script>

<%- include('../../partials/siteFooter') %>
