<%- include('../../partials/siteHeader', {pageTitle: "Explore Movies"}) %>

<div class="container py-4">
    <!-- Search & Hero Section -->
    <section class="hero-search text-center">
        <h2 class="fw-bold mb-2">Find Your Next Movie</h2>
        <p class="text-secondary mb-4">Browse recent releases, explore genres, or search by title</p>

        <div class="search-container">
            <form action="/moviesSearch" method="GET">
                <div class="search-input-group">
                    <i class="bi bi-search text-secondary ms-2 me-2"></i>
                    <input type="text" class="search-input" placeholder="Search by title (e.g. Batman, Avatar, Spider-Man)..." 
                           name="partOfMovieTitle" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" required>
                    <button class="btn btn-cinema search-btn" type="submit">Search</button>
                </div>
            </form>
        </div>

        <!-- Genre Filter Buttons (Action, Drama, Comedy, All) -->
        <div class="genre-filter-wrapper">
            <a href="/movies" class="genre-pill <%= (typeof activeGenre !== 'undefined' && activeGenre === 'all') ? 'active' : '' %>">
                <i class="bi bi-grid-fill"></i>
                All Recent
            </a>
            <a href="/movies/genre/Action" class="genre-pill <%= (typeof activeGenre !== 'undefined' && activeGenre === 'action') ? 'active' : '' %>">
                <i class="bi bi-fire"></i>
                Action
            </a>
            <a href="/movies/genre/Drama" class="genre-pill <%= (typeof activeGenre !== 'undefined' && activeGenre === 'drama') ? 'active' : '' %>">
                <i class="bi bi-mask"></i>
                Drama
            </a>
            <a href="/movies/genre/Comedy" class="genre-pill <%= (typeof activeGenre !== 'undefined' && activeGenre === 'comedy') ? 'active' : '' %>">
                <i class="bi bi-emoji-laughing"></i>
                Comedy
            </a>
        </div>
    </section>

    <!-- Movies Listing Section -->
    <section class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h4 fw-bold mb-0">
                    <% if (typeof activeGenre !== 'undefined' && activeGenre && activeGenre !== 'all') { %>
                        Recent <%= activeGenre.charAt(0).toUpperCase() + activeGenre.slice(1) %> Movies
                    <% } else if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        Search Results for "<%= searchQuery %>"
                    <% } else { %>
                        Recent Movies (Latest 20)
                    <% } %>
                </h3>
                <small class="text-secondary">Showing <%= movies ? movies.length : 0 %> titles</small>
            </div>
            <a href="/movies/createForm" class="btn btn-cinema btn-sm">
                <i class="bi bi-plus-lg"></i> Add Movie
            </a>
        </div>

        <% if (movies && movies.length > 0) { %>
            <div class="movies-grid">
                <% movies.forEach(function(movie) { %>
                    <article class="movie-card">
                        <div class="poster-wrap">
                            <% if (movie.thumbnail) { %>
                                <img src="<%= movie.thumbnail %>" class="poster-img" alt="<%= movie.title %>" 
                                     loading="lazy" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'poster-fallback\'><i class=\'bi bi-film fs-1\'></i><span>No Poster</span></div>';">
                            <% } else { %>
                                <div class="poster-fallback">
                                    <i class="bi bi-film fs-1"></i>
                                    <span>No Poster</span>
                                </div>
                            <% } %>
                            <% if (movie.year) { %>
                                <span class="movie-year-badge"><%= movie.year %></span>
                            <% } %>
                        </div>

                        <div class="movie-card-body">
                            <h4 class="movie-card-title" title="<%= movie.title %>"><%= movie.title %></h4>

                            <% if (movie.genres && movie.genres.length > 0) { %>
                                <div class="movie-tags">
                                    <% movie.genres.slice(0, 3).forEach(function(g) { %>
                                        <span class="tag-genre"><%= g %></span>
                                    <% }); %>
                                </div>
                            <% } %>

                            <div class="card-actions">
                                <a href="/movies/show/<%= movie._id %>" class="btn-card-action btn-card-details">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a href="/movies/updateForm/<%= movie._id %>" class="btn-card-action btn-card-edit" title="Edit Movie">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button" class="btn-card-action btn-card-delete" title="Delete Movie"
                                        onclick="confirmDelete('<%= movie._id %>', '<%= movie.title.replace(/'/g, '\\\'') %>')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="content-box text-center py-5">
                <i class="bi bi-film text-secondary fs-1 mb-3 d-block"></i>
                <h4>No Movies Found</h4>
                <p class="text-secondary mb-4">No matching movies found in this category.</p>
                <a href="/movies" class="btn btn-cinema">Back to All Movies</a>
            </div>
        <% } %>
    </section>
</div>

<script>
    function confirmDelete(id, title) {
        if (confirm("Are you sure you want to delete \"" + title + "\"?")) {
            window.location.href = "/movies/destroy/" + id;
        }
    }
</script>

<%- include('../../partials/siteFooter') %>